# SPDX-License-Identifier: Apache-2.0
# TWRP v2 fstab. Never used by init for automatic data formatting.
# Actual crypto parameters preserved; Phase 1 crypto is disabled.
system /system erofs ro wait,slotselect,logical,backup=1,wipeingui=0,canbewiped=0
system_ext /system_ext erofs ro wait,slotselect,logical,backup=1,wipeingui=0,canbewiped=0
product /product erofs ro wait,slotselect,logical,backup=1,wipeingui=0,canbewiped=0
vendor /vendor erofs ro wait,slotselect,logical,backup=1,wipeingui=0,canbewiped=0
odm /odm erofs ro wait,slotselect,logical,backup=1,wipeingui=0,canbewiped=0
vendor_dlkm /vendor_dlkm ext4 ro wait,slotselect,logical,backup=1,wipeingui=0,canbewiped=0
system_dlkm /system_dlkm ext4 ro wait,slotselect,logical,backup=1,wipeingui=0,canbewiped=0
/dev/block/by-name/boot /boot emmc defaults slotselect,backup=1,flashimg=1
/dev/block/by-name/init_boot /init_boot emmc defaults slotselect,backup=1,flashimg=1
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect,backup=1,flashimg=1
/dev/block/by-name/recovery /recovery emmc defaults slotselect,backup=1,flashimg=1
/dev/block/by-name/dtbo /dtbo emmc defaults slotselect,backup=1,flashimg=1
/dev/block/by-name/super /super emmc defaults backup=0,flashimg=0
/dev/block/by-name/misc /misc emmc defaults backup=0,flashimg=0
/dev/block/by-name/metadata /metadata f2fs noatime,nosuid,nodev,discard wait,backup=0,wipeingui=0,canbewiped=0
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt latemount,resize,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs,fscompress,backup=1,wipeingui=0,canbewiped=0
/devices/platform/soc/a600000.ssusb/* /usb-otg auto defaults removable,storage,backup=0,wipeingui=0
