# Dedicated recovery files are on rootfs, not a mounted Android /system.
# Match AOSP file_contexts so enforcing services can map the linker/libraries.
# Use labels at inode lookup rather than granting services rootfs execution.
recovery_only(`
genfscon rootfs /system/bin/linker64 u:object_r:system_linker_exec:s0
genfscon rootfs /system/lib64 u:object_r:system_lib_file:s0
genfscon rootfs /system/bin/lpdumpd u:object_r:lpdumpd_exec:s0
')
